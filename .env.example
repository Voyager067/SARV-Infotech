# Copy to .env and adjust as needed. docker-compose picks these up automatically.

JWT_SECRET=ekart-dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CORS_ORIGIN=http://localhost:5174

# Frontend branding (no rebuild needed in dev — only the Vite dev server needs a restart)
VITE_SITE_NAME=EKart
VITE_CREATOR_NAME=RITU ANAND

# Mongo Express (DB viewer at http://localhost:8081)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin123
